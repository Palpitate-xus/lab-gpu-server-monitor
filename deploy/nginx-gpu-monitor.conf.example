# Install under /etc/nginx/conf.d/ after replacing the hostname and certificate paths.
limit_req_zone $binary_remote_addr zone=gpumon_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=gpumon_api:10m rate=120r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name gpu-monitor.example.com;
    return 301 https://gpu-monitor.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gpu-monitor.example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/gpu-monitor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gpu-monitor.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 1m;
    large_client_header_buffers 4 16k;
    max_ranges 5;

    location = /api/auth/login {
        limit_req zone=gpumon_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8300;
        proxy_set_header Host gpu-monitor.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/auth/login-json {
        limit_req zone=gpumon_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8300;
        proxy_set_header Host gpu-monitor.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        limit_req zone=gpumon_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8300;
        proxy_http_version 1.1;
        proxy_set_header Host gpu-monitor.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, rather than append, so a client-supplied XFF cannot spoof
        # the source address used by application rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}
