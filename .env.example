# Copy to .env, keep mode 0600, and generate independent values. Empty or
# placeholder secrets are rejected at startup.
#   openssl rand -hex 32
JWT_SIGNING_KEY=
CREDENTIAL_ENCRYPTION_KEYS=
ARCHIVE_ENCRYPTION_KEY=

# Safe local default. For MySQL, use a least-privilege account and TLS:
# DATABASE_URL=mysql+pymysql://gpumon:URL_ENCODED_PASSWORD@db.example:3306/gpu_monitor?charset=utf8mb4
# Optional for a same-host MySQL certificate hostname that is not in DNS.
# GPU_MONITOR_DB_HOST_ALIAS=MySQL_Server_Certificate_Common_Name
# DATABASE_SSL_CA=/run/secrets/gpu-monitor/mysql-ca.pem
# DATABASE_SSL_CERT=/run/secrets/gpu-monitor/mysql-client.pem
# DATABASE_SSL_KEY=/run/secrets/gpu-monitor/mysql-client.key
DATABASE_URL=sqlite:///./data/gpu_monitor.db
AUTO_MIGRATE=no

# Required only when the database does not already contain an administrator.
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# Browser deployment: keep yes behind the required HTTPS reverse proxy.
COOKIE_SECURE=yes
COOKIE_SAMESITE=strict
# Only for loopback development together with COOKIE_SECURE=no.
ALLOW_INSECURE_HTTP=no
# Keep disabled until the application's direct proxy peer address is known.
TRUST_PROXY=no
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=

# Optional shared cache. Remote Redis must use rediss:// with authentication;
# REDIS_SSL_CA may point at a private CA bundle. Leave both empty for one worker.
REDIS_URL=
REDIS_SSL_CA=

# Security-sensitive features are opt-in.
REMOTE_PROCESS_CONTROL_ENABLED=no
ALLOW_ROOT_SSH=no
REQUIRE_ADMIN_MFA=yes

# Archive deletion is refused unless both values are configured.
ARCHIVE_DIR=/app/archives

# Deployment resource knobs used by docker-compose.yml.
GPU_MONITOR_PORT=8300
GPU_MONITOR_MEMORY_LIMIT=2g
GPU_MONITOR_CPU_LIMIT=2.0
# Required. Build/staging may use a reviewed commit-SHA tag; production should
# use the corresponding immutable registry digest.
GPU_MONITOR_IMAGE=
