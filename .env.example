# Copy to .env and fill in real values. NEVER commit .env.
# SECRET_KEY: JWT signing + SSH credential encryption.
#   Generate: openssl rand -hex 32
#   Rotating it invalidates all stored SSH credentials (must re-enter them).
SECRET_KEY=change-me-run-openssl-rand-hex-32

# Database. MySQL example (Docker bridge gateway when MySQL runs on the same host):
# DATABASE_URL=mysql+pymysql://gpumon:gpumon_pass_2024@172.17.0.1:3306/gpu_monitor?charset=utf8mb4
# SQLite fallback (zero external dependencies):
# DATABASE_URL=sqlite:///./data/gpu_monitor.db

# --- optional ---
# TRUST_PROXY=yes          # set when behind a reverse proxy (trust X-Forwarded-For)
# CORS_ORIGINS=https://x   # cross-origin whitelist; default = same-origin only
